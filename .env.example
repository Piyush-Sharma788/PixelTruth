# PixelTruth — Environment Variables
# Copy this file to .env (optional). Every value below has a working default.
# ─────────────────────────────────────────────────────────────────────

# ── Model ────────────────────────────────────────────────────────────
# The trained model ships with the repository as deepfake_detection_model.h5,
# so nothing needs to be set for a normal checkout.
PIXELTRUTH_MODEL_PATH=deepfake_detection_model.h5

# Optional: HTTPS URL to download the model from when PIXELTRUTH_MODEL_PATH
# does not exist (e.g. a GitHub Release asset). Leave blank to disable.
PIXELTRUTH_MODEL_URL=

# Optional SHA-256 of the model file; checked on every load when set.
# The bundled model's digest is recorded in deepfake_detection_model.json.
PIXELTRUTH_MODEL_SHA256=

# ── API Security ─────────────────────────────────────────────────────
# Secret required in the X-API-Key header. Blank = open access (dev only).
PIXELTRUTH_API_KEY=

# ── Rate Limiting (slowapi "N/period") ───────────────────────────────
PIXELTRUTH_RATE_LIMIT=10/minute
PIXELTRUTH_POLL_RATE_LIMIT=120/minute
# Max async tasks queued/running at once (each holds its upload in memory)
PIXELTRUTH_MAX_ACTIVE_TASKS=32
# Seconds a finished async task result is kept
PIXELTRUTH_TASK_TTL=300

# ── CORS ─────────────────────────────────────────────────────────────
PIXELTRUTH_CORS_ORIGINS=http://localhost:8501,http://localhost:8000

# ── History Database ─────────────────────────────────────────────────
PIXELTRUTH_DB_PATH=pixeltruth_history.db
# 1 = save history to SQLite (shared by everyone using this server).
# 0 = per-browser-session history only. Use 0 for public deployments.
PIXELTRUTH_PERSIST_HISTORY=1

# ── Image Safety ─────────────────────────────────────────────────────
# Maximum pixel count (width × height) accepted. Default: 25 000 000 (25MP).
PIXELTRUTH_MAX_PIXELS=25000000
